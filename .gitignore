# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# Metro
.metro-health-check*

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# editors
.vscode/
.idea/
*.swp
*.swo

# local env files (commit .env.example, never the real thing)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders (EAS prebuild output)
/ios
/android

# local build artifacts
*.apk
*.aab
*.apks

# test / coverage output
coverage/
